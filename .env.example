# Required: Discord webhook URL for alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# Optional: Polling interval in milliseconds (default: 12000)
# POLL_INTERVAL_MS=12000

# Optional: State file path (default: ./state.json)
# STATE_PATH=./state.json

# Optional: Polymarket API endpoints (defaults work for production)
# PM_DATA_API=https://data-api.polymarket.com
# PM_GAMMA_API=https://gamma-api.polymarket.com
# PM_CLOB_WSS=wss://ws-subscriptions-clob.polymarket.com/ws/

# Optional: Filter settings
# Exclude categories (comma-separated, default: sports,crypto)
# EXCLUDE_CATEGORIES=sports,crypto

# Minimum Gamma liquidity in USD (default: 25000)
# MIN_GAMMA_LIQUIDITY_USD=25000

# Minimum top 5 book depth in USD (default: 8000)
# MIN_TOP5_BOOK_DEPTH_USD=8000
